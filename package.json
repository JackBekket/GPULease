{
  "name": "gpulease",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "hardhat build",
    "artifacts:abi": "hardhat run scripts/generate-artifacts.ts",
    "deploy:base:all": "hardhat run scripts/deploy-all-base.ts --network base",
    "deploy:base:gpulease-upgrade": "hardhat run scripts/upgrade-gpulease-base.ts --network base",
    "deploy:base:bonus-stack": "hardhat run scripts/deploy-bonus-stack-base.ts --network base",
    "deploy:base:campaign-fee": "hardhat run scripts/deploy-campaign-fee-base.ts --network base",
    "deploy:base:verifier": "hardhat run scripts/deploy-verifier.ts --network base",
    "deploy:base:factory": "hardhat run scripts/deploy-campaign-factory.ts --network base",
    "verify:base": "npm run verify:base:wallet && npm run verify:base:referral && npm run verify:base:gpulease && npm run verify:base:metadata-renderer && npm run verify:base:factory && npm run verify:base:campaign-implementation && npm run verify:base:verifier",
    "verify:base:wallet": "hardhat verify etherscan --network base --contract contracts/GPULeaseWallet.sol:GPULeaseWallet ${GPULEASE_WALLET_ADDRESS:-0xf6d56d64938b65c6Ad58cFD447Cd1d74b39eEeF2} ${USDC_ADDRESS:-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913}",
    "verify:base:referral": "hardhat verify etherscan --network base --contract contracts/GPULeaseReferral.sol:GPULeaseReferral ${GPULEASE_REFERRAL_ADDRESS:-0x2695d98bF8b233539f5a1Fb823298AA055f2a143}",
    "verify:base:factory": "hardhat verify etherscan --network base --contract contracts/CampaignFactory.sol:LLMFundraisingFactory ${CAMPAIGN_FACTORY_ADDRESS:-0x40C99f349A8cB30d452c9cdc7808221D57427851} ${USDC_ADDRESS:-0x833589fcd6edb6e08f4c7c32d4f71b54bda02913} ${GPULEASE_WALLET_ADDRESS:-0xf6d56d64938b65c6Ad58cFD447Cd1d74b39eEeF2} ${CAMPAIGN_METADATA_RENDERER_ADDRESS:-0x48a862d4ca9aE88699251B38097064B8967F405c} ${TREASURY_ADDRESS:-0x80CFfF5C710E3e21050AaB272201B574a53A66B3}",
    "verify:base:gpulease": "hardhat verify etherscan --network base --contract contracts/GPULease.sol:GPULease ${GPULEASE_ADDRESS:-0x1350d6D31dc4c8B1314aF51d99e61cF0E3da938f} ${GPULEASE_WALLET_ADDRESS:-0xf6d56d64938b65c6Ad58cFD447Cd1d74b39eEeF2} ${TREASURY_ADDRESS:-0x80CFfF5C710E3e21050AaB272201B574a53A66B3}",
    "verify:base:metadata-renderer": "hardhat verify etherscan --network base --contract contracts/CampaignMetadataRenderer.sol:CampaignMetadataRenderer ${CAMPAIGN_METADATA_RENDERER_ADDRESS:-0x48a862d4ca9aE88699251B38097064B8967F405c}",
    "verify:base:campaign-implementation": "hardhat verify etherscan --network base --contract contracts/Campaign.sol:LLMFundraising ${CAMPAIGN_IMPLEMENTATION_ADDRESS:-0x0b085C432C4dDAC1C8EF2D4b3C259F5ace69cbd4}",
    "verify:base:verifier": "hardhat verify etherscan --network base --contract contracts/Verifier.sol:Verifier ${VERIFIER_ADDRESS:-0xcacA2090Ae57d990A1A5CbDC43d8128864380511}",
    "test": "hardhat test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.6",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.3",
    "@nomicfoundation/hardhat-ignition": "^3.0.8",
    "@nomicfoundation/hardhat-mocha": "^3.0.13",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.4",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.3",
    "@nomicfoundation/hardhat-typechain": "^3.0.4",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.13",
    "chai": "^6.2.2",
    "ethers": "^6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.1.10",
    "mocha": "^11.7.5",
    "typescript": "~5.8.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
